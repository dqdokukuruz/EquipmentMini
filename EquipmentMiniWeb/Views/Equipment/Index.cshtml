@model IEnumerable<EquipmentMini.Entities.Equipment>

@{
    ViewData["Title"] = "Оборудване";
}

<h1>Оборудване</h1>


<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="searchString"
               value="@ViewData["CurrentFilter"]"
               class="form-control"
               placeholder="Търси по име, номер, категория или стая..." />

        <button type="submit" class="btn btn-primary">Търси</button>
        <a asp-action="Index" class="btn btn-secondary">Изчисти</a>
    </div>
</form>


<table class="table">
    <thead>
        <tr>
            <th>Име</th>
            <th>Инвентарен номер</th>
            <th>Категория</th>
            <th>Стая</th>
            <th>Състояние</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.InventoryNumber</td>
                <td>@item.Category</td>
                <td>@item.Room</td>
                <td>@item.Condition</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">
                        Редактирай
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">
                        Изтрий
                    </a>
                </td>

            </tr>
        }
    </tbody>
</table>
