@model EquipmentMini.Entities.Equipment

@{
    ViewData["Title"] = "Изтриване на оборудване";
}

<h1>Изтриване на оборудване</h1>

<h3>Сигурен ли си, че искаш да изтриеш това оборудване?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Име</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Инвентарен номер</dt>
        <dd class="col-sm-10">@Model.InventoryNumber</dd>

        <dt class="col-sm-2">Категория</dt>
        <dd class="col-sm-10">@Model.Category</dd>

        <dt class="col-sm-2">Стая</dt>
        <dd class="col-sm-10">@Model.Room</dd>

        <dt class="col-sm-2">Състояние</dt>
        <dd class="col-sm-10">@Model.Condition</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Изтрий</button>
        <a asp-action="Index" class="btn btn-secondary">Отказ</a>
    </form>
</div>
